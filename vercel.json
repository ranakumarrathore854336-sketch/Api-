{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api.php",
      "destination": "/api/index?match=api.php"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index?match=$1"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
